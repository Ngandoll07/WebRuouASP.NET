@model WebRuou.Models.Order
@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="page-inner">
        <div class="content-wrapper">
            <div class="page-header">
                <h3 class="page-title">Chi tiết đơn hàng #@Model.OrderID</h3>
            </div>

            <div class="card-body">
                <h4>Thông tin khách hàng</h4>
                <table class="table">
                    <tr>
                        <th>Họ tên:</th>
                        <td>@(Model.User != null ? Model.User.FullName : "Không xác định")</td>
                    </tr>
                    <tr>
                        <th>Email:</th>
                        <td>@(Model.User != null ? Model.User.Email : "Không xác định")</td>
                    </tr>
                    <tr>
                        <th>Số điện thoại:</th>
                        <td>@(Model.User != null ? Model.User.Phone : "Không xác định")</td>
                    </tr>
                </table>

                <h4>Sản phẩm đặt hàng</h4>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                            <th>Tổng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(detail.Product != null ? detail.Product.Name : "Không xác định")</td>
                                <td>@detail.Quantity</td>
                                <td>@detail.Price VNĐ</td>
                                <td>@(detail.Quantity * detail.Price) VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <p><strong>Tổng tiền: </strong> @Model.TotalAmount VNĐ</p>
                <p><strong>Trạng thái: </strong> @Model.Status</p>
                <p><strong>Ngày đặt: </strong> @(Model.OrderDate?.ToString("dd/MM/yyyy"))</p>

                <a href="@Url.Action("Index", "Order")" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>

