@using WebRuou.Models
@using PagedList.Mvc;
@model PagedList.PagedList<User>

@{
    ViewBag.Title = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h3 class="page-title"> Quản lý người dùng </h3>
    <form method="get" class="form-inline mb-3">
        <div class="row">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control mr-2" placeholder="Tìm theo tên, email hoặc địa chỉ" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">Reset</a>
            </div>

        </div>
        
        
    </form>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>STT</th>
                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.NameSortParam, searchString = ViewBag.SearchString })">Họ tên</a></th>
                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.EmailSortParam, searchString = ViewBag.SearchString })">Email</a></th>
                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.AddressSortParam, searchString = ViewBag.SearchString })">Địa chỉ</a></th>
                <th>Điện thoại</th>
                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.StatusSortParam, searchString = ViewBag.SearchString })">Trạng thái</a></th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                var i = 1;
                foreach (var user in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Address</td>
                        <td>@user.Phone</td>
                        <td>
                            @if (user.IsActive == true)
                            {
                                <span class="badge badge-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Bị khóa</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("ToggleStatus", "User", new { id = user.UserID })" class="btn btn-warning">
                                @(user.IsActive == true ? "Vô hiệu hóa" : "Kích hoạt")
                            </a>
                            <a href="@Url.Action("Wishlist", "User", new { id = user.UserID })" class="btn btn-info">Yêu thích</a>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">Không có người dùng nào</td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }))
    </div>
</div>
