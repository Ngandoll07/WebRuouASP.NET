<!-- Vesitable Shop Start-->
<div class="container-fluid vesitable">
    <div class="container py-3">
        <div class="container">
            <div class="row">
                <!-- Sidebar danh mục -->
                <div class="col-md-3">
                    <div class="category-box">
                        <h4>DANH MỤC SẢN PHẨM</h4>
                        <ul>
                            <!-- Link "Tất cả sản phẩm" -->
                            <li>
                                <a href="@Url.Action("Index", "Product")" class="@(ViewBag.SelectedCategory == null ? "font-weight-bold text-primary" : "")">
                                    Tất cả sản phẩm
                                </a>
                            </li>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <li>
                                        <a href="@Url.Action("Index", "Product", new { categoryId = category.CategoryID })"
                                           class="@(ViewBag.SelectedCategory == category.CategoryID ? "font-weight-bold text-primary" : "")">
                                            @category.CategoryName (@category.Products.Count)
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <p>Không có danh mục nào.</p>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Sản phẩm -->
                <div class="col-md-9">
                    <h2 class="text-center">SẢN PHẨM BÁN CHẠY</h2>
                    <div class="row">
                        @if (ViewBag.Products != null && ViewBag.Products.Count > 0)
                        {
                            <div class="row">
                                @foreach (var product in ViewBag.Products)
                                {
                                    <div class="col-md-4">
                                        <div class="product-item">
                                            <a href="@Url.Action("ProductDetail", "Product", new { id = product.ProductID })">
                                                <img src="@product.ImageURL" alt="@product.Name">
                                            </a>
                                            <h5>@product.Name</h5>
                                            <p class="price">@(product.Price?.ToString("N0")) VNĐ</p>
                                            <a href="@Url.Action("AddToCart", "Cart", new { productID = product.ProductID })"
                                               class="btn btn-success btn-buy btn-cart btn btn-primary left-to add_to_cart">
                                                Thêm vào giỏ
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Nút Xem Thêm -->
                            <div class="text-center mt-4">
                                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary">Xem thêm</a>
                            </div>
                        }
                        else
                        {
                            <p>Không có sản phẩm nào.</p>
                        }
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>
<!-- Vesitable Shop End -->
