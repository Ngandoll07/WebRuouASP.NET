@model IEnumerable<WebRuou.Models.Product>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Modal Search End -->
<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <img src="//bizweb.dktcdn.net/100/022/044/themes/895031/assets/slider_1.jpg?1676343869963" alt="" class="img-responsive center-block">
</div>
<!-- Hero End -->
<!-- Featurs Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container ">
        <div class="row g-4">
            <div class="col-md-6 ">
                <img src="https://bizweb.dktcdn.net/thumb/grande/100/022/044/themes/895031/assets/banner2_1.jpg?1676343869963" alt="">
            </div>
            <div class="col-md-6 ">
                <img src="https://bizweb.dktcdn.net/thumb/grande/100/022/044/themes/895031/assets/banner2_2.jpg?1676343869963" alt="">
            </div>
        </div>
    </div>
</div>
<!-- Featurs Section End -->
<!-- Fruits Shop Start-->
<div class="container-fluid favorite-products">
    <h2 class="title">Được ưa thích nhất</h2>
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            @if (ViewBag.Products != null && ViewBag.Products.Count > 0)
            {
                foreach (var product in ViewBag.Products)
                {
                    <div class="swiper-slide product-item">
                        <div class="discount-label">8%</div>
                        <a href="@Url.Action("ProductDetail", "Product", new { id = product.ProductID })">
                            <img src="@product.ImageURL" alt="@product.Name">
                        </a>
                        <h5>@product.Name</h5>
                        <p class="price">@(product.Price?.ToString("N0")) VNĐ</p>
                        <a href="@Url.Action("AddToCart", "Cart", new { productID = product.ProductID })" class="btn btn-success btn-buy btn-cart btn btn-primary left-to add_to_cart">Thêm vào giỏ</a>
                    </div>
                }
            }
            else
            {
                <p>Không có sản phẩm cùng loại.</p>
            }
        </div>
    </div>
</div>
<!-- Fruits Shop End-->
