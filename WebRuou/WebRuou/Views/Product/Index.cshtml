@using WebRuou.Models
@using PagedList.Mvc;
@model PagedList.PagedList<Product>
@{
    ViewBag.Title = "Tất cả sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .col-md-9, .category-box {
        margin-top: 100px;
    }
    .pagination {
        display: flex;
        justify-content: center;
        list-style: none;
        padding: 0;
        margin-top: 20px;
    }

        .pagination li {
            margin: 0 5px;
        }

            .pagination li a,
            .pagination li span {
                padding: 8px 12px;
                text-decoration: none;
                color: #007bff;
                border: 1px solid #ddd;
                border-radius: 4px;
                transition: background-color 0.3s ease;
            }

                .pagination li a:hover,
                .pagination li span:hover {
                    background-color: #007bff;
                    color: white;
                }

            .pagination li.active span {
                background-color: #007bff;
                color: white;
                border-color: #007bff;
            }

            .pagination li.disabled span {
                color: #6c757d;
                cursor: not-allowed;
                background-color: #e9ecef;
                border-color: #ddd;
            }
</style>

<!-- Danh mục sản phẩm + sản phẩm -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row">
            <!-- Sidebar danh mục -->
            <!-- Sidebar danh mục -->
            <div class="col-md-3">
                <div class="category-box">
                    <h4>DANH MỤC SẢN PHẨM</h4>
                    <ul>
                        <!-- Link "Tất cả sản phẩm" -->
                        <li>
                            <a href="@Url.Action("Index", "Product")" class="@(ViewBag.SelectedCategory == null ? "font-weight-bold text-primary" : "")">
                                Tất cả sản phẩm
                            </a>
                        </li>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Product", new { categoryId = category.CategoryID })"
                                       class="@(ViewBag.SelectedCategory == category.CategoryID ? "font-weight-bold text-primary" : "")">
                                        @category.CategoryName (@category.Products.Count)
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <p>Không có danh mục nào.</p>
                        }
                    </ul>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="col-md-9">
                <h2 class="text-center">Tất cả sản phẩm</h2>
                <div class="row">
                    @if (ViewBag.Products != null)
                    {
                        <div class="row">
                            @foreach (var product in ViewBag.Products)
                            {
                                <div class="col-md-4">
                                    <div class="product-item">
                                        <a href="@Url.Action("ProductDetail", "Product", new { id = product.ProductID })">
                                            <img src="@product.ImageURL" alt="@product.Name">
                                        </a>
                                        <h5>@product.Name</h5>
                                        <p class="price">@(product.Price?.ToString("N0")) VNĐ</p>
                                        <a href="@Url.Action("AddToCart", "Cart", new { productID = product.ProductID })" class="btn btn-success btn-buy btn-cart btn btn-primary left-to add_to_cart">Thêm vào giỏ</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Không có sản phẩm nào.</p>
                    }

                </div>
            </div>
        </div>
        <div>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }))
        </div>
    </div>
</div>
