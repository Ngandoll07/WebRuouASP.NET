@model WebRuou.Models.Order
@{
    ViewBag.Title = "OrderDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-6">
    <div class="container py-6">
        <section class="bread-crumb">
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 a-left">
                        <ul class="breadcrumb">
                            <li class="home">
                                <a style="color: #898989;" href="/"><span>Trang chủ</span></a>
                                <span class="br-line">|</span>
                            </li>
                            <li style="color: #E8b34F;"><strong><span>📦 Chi tiết đơn hàng của tôi</span></strong></li>

                        </ul>
                    </div>
                </div>
            </div>
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price VNĐ</td>
                            <td>@(item.Quantity * item.Price) VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>

            @foreach (var item in Model.OrderDetails)
            {
                <h3 class="mb-4">📝 Đánh giá sản phẩm</h3>
                <div class="card mb-4 shadow-sm border-0 rounded-3">
                    <div class="card-body">
                        <h5 class="card-title text-info fw-bold">@item.Product.Name</h5>
                        <form action="@Url.Action("SubmitReview", "Review")" method="post">
                            <input type="hidden" name="ProductID" value="@item.ProductID" />
                            <input type="hidden" name="UserID" value="@Model.UserID" />

                            <div class="mb-3">
                                <label for="Rating" class="form-label fw-semibold">Chọn đánh giá:</label>
                                <select name="Rating" class="form-select">
                                    <option value="5">⭐️⭐️⭐️⭐️⭐️ Tuyệt vời</option>
                                    <option value="4">⭐️⭐️⭐️⭐️ Tốt</option>
                                    <option value="3">⭐️⭐️⭐️ Bình thường</option>
                                    <option value="2">⭐️⭐️ Dưới trung bình</option>
                                    <option value="1">⭐️ Tệ</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="Comment" class="form-label fw-semibold">Bình luận:</label>
                                <textarea name="Comment" class="form-control border-2" rows="3" placeholder="Nhập đánh giá của bạn..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-send"></i> Gửi đánh giá
                            </button>
                        </form>
                    </div>
                </div>
            }

            <a href="@Url.Action("MyOrders", "Checkout")" class="btn btn-secondary">Quay lại</a>
        </section>
        <!-- Hiển thị đánh giá từ khách hàng -->
        <h3 class="mt-5">📢 Đánh giá từ khách hàng</h3>
        @foreach (var item in Model.OrderDetails)
        {
            var reviews = item.Product.Reviews.Where(r => !r.IsHidden).ToList(); // Lọc đánh giá hiển thị
            <h5 class="mt-3">@item.Product.Name</h5>

            if (reviews != null && reviews.Any())
            {
            <div class="reviews-container">
                @for (int i = 0; i < reviews.Count; i++)
                {
                    var review = reviews[i];
                    <div class="card mb-2 p-3 review-item" style="@(i == 0 ? "" : "display: none;")">
                        <p><strong>@review.User.FullName</strong> - @review.ReviewDate</p>
                        <p>⭐ @review.Rating / 5</p>
                        <p>@review.Comment</p>
                    </div>
                }
            </div>

                if (reviews.Count > 1)
                {
                    <button id="toggleReviews" class="btn btn-link">Xem thêm</button>
                }
            }
            else
            {
                <p class="text-muted">Chưa có đánh giá nào.</p>
            }
        }

    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let btnToggle = document.getElementById("toggleReviews");
        let reviews = document.querySelectorAll(".review-item");
        let isExpanded = false;

        if (btnToggle) {
            btnToggle.addEventListener("click", function () {
                isExpanded = !isExpanded;
                reviews.forEach((review, index) => {
                    if (index > 0) { // Bỏ qua phần tử đầu tiên
                        review.style.display = isExpanded ? "block" : "none";
                    }
                });

                btnToggle.textContent = isExpanded ? "Ẩn bớt" : "Xem thêm";
            });
        }
    });
</script>



